{
  "name": "backend-ecommerce-pos",
  "version": "1.0.0",
  "description": "Headless E-commerce Backend with POS Integration",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "node --loader tsx migrations/run.ts",
    "seed": "tsx src/shared/factories/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "ecommerce",
    "pos",
    "headless",
    "api",
    "graphql",
    "shopify",
    "medusa"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^8.3.1",
    "@hono/node-server": "^1.8.0",
    "bcrypt": "^5.1.1",
    "date-fns": "^3.0.0",
    "dotenv": "^8.2.0",
    "drizzle-orm": "^0.30.0",
    "graphql": "^16.8.1",
    "graphql-yoga": "^5.1.1",
    "hono": "^4.0.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.0",
    "nats": "^2.19.0",
    "node-fetch": "^3.3.2",
    "postgres": "^3.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "prettier": "^3.2.0",
    "drizzle-kit": "^0.20.0",
    "testcontainers": "^10.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

# ============================================================================
# E-COMMERCE BACKEND + POS - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_pos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_pos
DB_USER=postgres
DB_PASSWORD=postgres

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================================================
# REDIS - Session & Caching
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# NATS - Message Queue & Event Bus
# ============================================================================
NATS_URL=nats://localhost:4222
NATS_HOST=localhost
NATS_PORT=4222
NATS_CLUSTER_ID=ecommerce-cluster

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# IMPORTANT: Change these to strong random secrets in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Token expiration times
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# BCRYPT - Password Hashing
# ============================================================================
# Number of salt rounds (10-12 recommended, higher = more secure but slower)
BCRYPT_ROUNDS=12

# ============================================================================
# CORS - Cross-Origin Resource Sharing
# ============================================================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
CORS_CREDENTIALS=true

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================================================
# FILE UPLOADS & STORAGE
# ============================================================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# S3-Compatible Storage (MinIO for local, AWS S3 for production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ecommerce-assets
S3_REGION=us-east-1
S3_USE_SSL=false

# AWS S3 (Production)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=your-production-bucket

# ============================================================================
# EMAIL - SMTP Configuration
# ============================================================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@yourstore.com

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# ============================================================================
# SHIPPING PROVIDERS
# ============================================================================
# Shippo API
SHIPPO_API_KEY=shippo_test_...

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# ============================================================================
# GRAPHQL
# ============================================================================
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# ============================================================================
# WEBHOOKS
# ============================================================================
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRY_ATTEMPTS=3

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=

# Google Analytics
GA_TRACKING_ID=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_GRAPHQL=true
ENABLE_REST_API=true
ENABLE_WEBSOCKETS=false
ENABLE_DATA_FACTORY=true

# ============================================================================
# SEEDING & DEVELOPMENT
# ============================================================================
# Set to true to seed the database with fake data on startup
AUTO_SEED_DATABASE=false
SEED_COUNT_PRODUCTS=100
SEED_COUNT_CUSTOMERS=50
SEED_COUNT_ORDERS=200
